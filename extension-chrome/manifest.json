{
  "manifest_version": 3,
  "name": "Bénin Control — Recherche MMTE et GUCE",
  "short_name": "Recherche MMTE GUCE",
  "version": "1.1.0",
  "description": "Recherche des châssis dans MMTE et le GUCE pour l'application Inventaire MMTE. Lecture seule, avec vos propres connexions.",
  "permissions": ["scripting", "tabs", "offscreen"],
  "host_permissions": ["https://mmte.benincontrol.com/*", "https://guce.gouv.bj/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://dine97.github.io/inventairemmte/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["pont.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Recherche MMTE et GUCE (Bénin Control)" },
  "icons": { "128": "icone128.png", "48": "icone48.png" }
}
